module(
    name = "rules_cloudrun",
    version = "2.0.0",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.47.0")
bazel_dep(name = "rules_img", version = "0.3.13")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "aspect_rules_lint", version = "2.1.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_google_go_containerregistry", "com_github_justinswe_std", "com_github_spf13_cobra", "com_github_stretchr_testify", "com_google_cloud_go_run", "in_gopkg_yaml_v3", "io_k8s_apimachinery", "org_golang_google_genproto_googleapis_api", "org_golang_google_protobuf", "org_golang_x_oauth2")

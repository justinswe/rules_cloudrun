load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "manifest",
    srcs = ["manifest.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        ":providers",
        "@rules_img//img:providers",
    ],
)

bzl_library(
    name = "deploy",
    srcs = ["deploy.bzl"],
    visibility = ["//visibility:public"],
    deps = [":providers"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
    visibility = ["//visibility:public"],
)
